# Ignore macOS-only keywords so this file parses on Linux too. OpenSSH
# rejects the whole block containing an unrecognised keyword, which is why
# the "Host *" block below had to be commented out entirely. Must stay near
# the top: it does not apply to unknown options appearing before it.
IgnoreUnknown UseKeychain

# Agent settings
ServerAliveInterval 60

# Services
Host github
    HostName github.com
    User git
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    #IdentityFile ~/.ssh/id_rsa
    IdentityFile ~/.ssh/ialonso
Host gitlab
    HostName gitlab.com
    User git
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

# Other
Host truenas
    HostName 10.10.10.110
    User root
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host pi
    HostName 10.10.10.104
    User bledy
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host truenas-vpn
    HostName 10.0.0.110
    User root
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host pi-vpn
    HostName 10.0.0.104
    User bledy
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host 10.10.10.*
    User bledy
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host 10.0.0.*
    User bledy
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

# Marfeel Hetzner servers
Host *.het
    HostName %h.mrf.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso

# Marfeel OVH servers
Host *.ovh
    HostName %h.mrf.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso

# Marfeel AWS servers
Host *.aws
    HostName %h.mrf.io
    Port 22002
    User ec2-user
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/awsmrfsys2018

# Marfeel K8S servers
Host *.k8s
    HostName %h.mrf.io
    Port 22002
    User root
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/hetzner_default_rsa_key
    IdentityFile ~/.ssh/ovh_default_rsa_key

# Marfeel mrf.io servers
Host *.mrf
    HostName %h.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso-cert

# Marfeel mrf.lan servers
Host *.mrf.lan
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso-cert

# Marfeel root domain servers
Host *.marfeel
    HostName %h.com
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso-cert

# Other
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
