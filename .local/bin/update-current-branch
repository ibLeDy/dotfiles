#!/usr/bin/env bash

set -e

if [ "$#" -gt 1 ]
then
    printf 'Usage: %s [base-branch]\n' "$0" >&2
    exit 2
fi

if [ "$#" -eq 1 ]
then
    BASE_BRANCH=$1
else
    if ! DEFAULT_BRANCH=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD)
    then
        printf 'Error: cannot detect the default branch from origin/HEAD.\n' >&2
        printf 'Pass the base branch explicitly or run: git remote set-head origin --auto\n' >&2
        exit 1
    fi
    BASE_BRANCH=${DEFAULT_BRANCH#origin/}
fi

CURRENT_BRANCH=$(git branch --show-current)

if [ -z "$CURRENT_BRANCH" ]
then
    printf 'Error: cannot update a detached HEAD.\n' >&2
    exit 1
fi

STASHED=false
STASH_COMMIT=

restore_stash()
{
    status=$?
    trap - EXIT

    if [ "$STASHED" = true ]
    then
        if [ "$(git rev-parse --verify refs/stash 2>/dev/null)" != "$STASH_COMMIT" ]
        then
            printf 'Error: temporary stash is no longer at the top of the stash list; restore it manually.\n' >&2
            exit 1
        fi

        if ! git stash pop --index
        then
            printf 'Error: could not restore the temporary stash; resolve it manually.\n' >&2
            exit 1
        fi
    fi

    exit "$status"
}

trap restore_stash EXIT

if [ -n "$(git status --porcelain)" ]
then
    git stash push --include-untracked --message "$0: temporary stash"
    STASH_COMMIT=$(git rev-parse --verify refs/stash)
    STASHED=true
fi

git checkout "$BASE_BRANCH"
git pull
git checkout "$CURRENT_BRANCH"
git merge "$BASE_BRANCH"
