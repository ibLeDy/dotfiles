#!/usr/bin/env bash
# Reminder hook (installed via git template): nag only when a repo has a
# pre-commit config but the pre-commit framework was never activated.
#
# Once `pre-commit install` runs, the framework relocates this script to
# .git/hooks/pre-commit.legacy and runs it in migration mode on every commit —
# we must NOT fail then, or we block commits exactly when pre-commit is working.

# 1. If we're the relocated legacy hook, pre-commit is installed → do nothing.
case "$0" in
  *.legacy) exit 0 ;;
esac

# 2. Belt and suspenders: if the active hook is the framework-generated one, skip.
hooks_dir="$(git rev-parse --git-path hooks 2>/dev/null)"
if [ -n "$hooks_dir" ] && grep -qsF 'generated by pre-commit' "$hooks_dir/pre-commit"; then
  exit 0
fi

# 3. Otherwise pre-commit is genuinely not installed — nag.
if [ -f .pre-commit-config.yaml ]; then
  echo 'pre-commit configuration detected, but `pre-commit install` was never run' >&2
  echo 'Run: pre-commit install' >&2
  exit 1
fi
