{
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[dockerfile]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false
    },
    "[helm]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": false,
        "editor.tabSize": 2
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.tabSize": 2
    },
    "[python]": {
        "editor.codeLens": false,
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[xml]": {
        "editor.autoClosingBrackets": "never",
        "files.trimFinalNewlines": false,
        "files.trimTrailingWhitespace": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
        // "editor.formatOnSave": true,
    },
    "ansible.ansibleLint.arguments": "-x \"yaml[line-length]\"",
    "black-formatter.args": [
        "--skip-string-normalization"
    ],
    "debug.allowBreakpointsEverywhere": true,
    "django.i18n": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.find.seedSearchStringFromSelection": "selection",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": false,
    "editor.fontSize": 13,
    "editor.guides.bracketPairs": true,
    "editor.linkedEditing": true,
    "editor.minimap.showSlider": "always",
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.rulers": [
        88,
        120
    ],
    "editor.smoothScrolling": true,
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "editor.suggestSelection": "first",
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "errorLens.enabled": false,
    "errorLens.messageTemplate": "[1/$count] $message [$severity] $source($code)",
    "explorer.autoReveal": true,
    "explorer.sortOrder": "filesFirst",
    "extensions.autoUpdate": false,
    "files.associations": {
        "**/*.html": "html",
        "**/galaxy.{yaml,yml}": "ansible",
        "**/handlers/*.{yaml,yml}": "ansible",
        "**/inventory/*.{yaml,yml}": "ansible",
        "**/meta/*.{yaml,yml}": "ansible",
        "**/molecule/*/*.{yaml,yml}": "ansible",
        "**/playbooks/*.{yaml,yml}": "ansible",
        "**/requirements{/**,*}.{txt,in}": "pip-requirements",
        "**/roles/*.{yaml,yml}": "ansible",
        "**/tasks/*.{yaml,yml}": "ansible",
        "**/templates/**/*.html": "django-html",
        "**/vault/*.{yaml,yml}": "ansible",
        "**/{host_vars,group_vars,vars,defaults}/**/*.{yaml,yml}": "ansible",
        "*.js.{jinja,jinja2,j2}": "jinja-js",
        "*.sh.{jinja,jinja2,j2}": "jinja-shell"
    },
    "files.exclude": {
        "**/*.egg-info": true,
        "**/*.pyc": true,
        "**/*venv": true,
        "**/.git": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": true,
    "flake8.args": [
        "--max-line-length=120"
    ],
    "git.autofetch": true,
    "gitlens.blame.highlight.locations": [
        "gutter",
        "line",
        "overview"
    ],
    "gitlens.codeLens.enabled": false,
    "gitlens.showWelcomeOnInstall": false,
    "gitlens.telemetry.enabled": false,
    "html-css-class-completion.enableEmmetSupport": true,
    "html.format.templating": true,
    "markdownlint.config": {
        "MD007": false,
        "MD033": false,
        "MD041": false
    },
    "markdownlint.ignore": [
        ".github/*"
    ],
    "mypy-type-checker.args": [
        "--check-untyped-defs",
        "--disallow-any-generics",
        "--disallow-incomplete-defs",
        "--follow-imports=silent",
        "--ignore-missing-imports",
        "--no-implicit-optional",
        "--no-implicit-reexport",
        "--show-error-codes",
        "--warn-redundant-casts",
        "--warn-return-any",
        "--warn-unreachable",
        "--warn-unused-configs",
        "--warn-unused-ignores"
    ],
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "oneDarkPro.bold": true,
    "oneDarkPro.editorTheme": "One Dark Pro Darker",
    "oneDarkPro.markdownStyle": false,
    "partialDiff.enableTelemetry": false,
    "prettier.vueIndentScriptAndStyle": true,
    "python.analysis.autoImportCompletions": false,
    "python.analysis.includeAliasesFromUserFiles": true,
    "python.languageServer": "Pylance",
    "python.testing.pytestEnabled": true,
    "pythonTestExplorer.testFramework": "pytest",
    "redhat.telemetry.enabled": false,
    "rust-analyzer.cargo.allFeatures": true,
    "rust-analyzer.completion.autoimport.enable": false,
    "rust-analyzer.debug.openDebugPane": true,
    "rust-analyzer.hoverActions.enable": false,
    "rust-analyzer.hoverActions.references": true,
    "rust-analyzer.lens.enable": false,
    "rust-analyzer.updates.askBeforeDownload": true,
    "rust-analyzer.workspace.symbol.search.kind": "all_symbols",
    "rust-analyzer.workspace.symbol.search.scope": "workspace_and_dependencies",
    "search.collapseResults": "auto",
    "search.exclude": {
        "**/*.egg-info": true,
        "**/*.git": true,
        "**/*.pyc": true,
        "**/*venv": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true
    },
    "search.searchOnType": true,
    "search.seedOnFocus": true,
    "search.showLineNumbers": true,
    "search.smartCase": true,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "terminal.integrated.env.osx": {
        "FIG_NEW_SESSION": "1"
    },
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.profiles.linux": {
        "bash": {
            "icon": "terminal-bash",
            "path": "/usr/bin/bash"
        },
        "tmux": {
            "icon": "terminal-tmux",
            "path": "/usr/local/bin/tmux"
        },
        "zsh": {
            "icon": "terminal-linux",
            "path": "/usr/bin/zsh"
        }
    },
    "terminal.integrated.profiles.osx": {
        "bash": {
            "icon": "terminal-bash",
            "path": "/bin/bash"
        },
        "tmux": {
            "icon": "terminal-tmux",
            "path": "/usr/local/bin/tmux"
        },
        "zsh": {
            "icon": "terminal",
            "path": "/bin/zsh"
        }
    },
    "terminal.integrated.scrollback": 100000,
    "testExplorer.gutterDecoration": false,
    "update.mode": "start",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "window.commandCenter": true,
    "window.menuBarVisibility": "compact",
    "window.title": "${dirty} ${activeEditorShort}${separator}${rootName} ${dirty}",
    "window.titleBarStyle": "custom",
    "workbench.activityBar.location": "top",
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#0066ff",
        "sash.hoverBorder": "#4B8BBE"
    },
    "workbench.editorAssociations": {},
    "workbench.enableExperiments": false,
    "workbench.hover.delay": 250,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.list.horizontalScrolling": true,
    "workbench.list.smoothScrolling": true,
    "workbench.preferredDarkColorTheme": "One Dark Pro Darker",
    "workbench.productIconTheme": "material-product-icons",
    "workbench.sash.hoverDelay": 50,
    "workbench.sash.size": 6,
    "workbench.startupEditor": "readme",
    "workbench.tree.expandMode": "doubleClick",
    "workbench.tree.indent": 22,
    "xml.format.preserveAttributeLineBreaks": true,
    "xml.format.spaceBeforeEmptyCloseTag": false,
    "xml.symbols.maxItemsComputed": 50000,
    "yaml.customTags": [
        "!And",
        "!And sequence",
        "!Base64",
        "!Cidr",
        "!encrypted/pkcs1-oaep scalar",
        "!Equals",
        "!Equals sequence",
        "!FindInMap",
        "!FindInMap sequence",
        "!GetAtt",
        "!GetAZs",
        "!If",
        "!If sequence",
        "!ImportValue",
        "!ImportValue sequence",
        "!Join",
        "!Join sequence",
        "!Not",
        "!Not sequence",
        "!Or",
        "!Or sequence",
        "!Ref",
        "!Select",
        "!Select sequence",
        "!Split",
        "!Split sequence",
        "!Sub",
        "!Sub sequence",
        "!vault scalar"
    ],
    "yaml.schemas": {
        "https://cdn.rawgit.com/martinring/tmlanguage/master/tmlanguage.json": "*.YAML-tmLanguage"
    },
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github"
    ],
    "workbench.secondarySideBar.defaultVisibility": "hidden"
}
