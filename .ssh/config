# Agent settings
ServerAliveInterval 60

# Services
Host github
    HostName github.com
    User git
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_rsa
    IdentityFile ~/.ssh/ialonso
Host gitlab
    HostName gitlab.com
    User git
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

# Other
Host pi
    HostName 10.10.10.104
    User bledy
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

# Marfeel Hetzner servers
Host *.het
    HostName %h.mrf.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso

# Marfeel OVH servers
Host *.ovh
    HostName %h.mrf.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso

# Marfeel AWS servers
Host *.aws
    HostName %h.mrf.io
    Port 22002
    User ec2-user
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/awsmrfsys2018

# Marfeel K8S servers
Host *.k8s
    HostName %h.mrf.io
    Port 22002
    User root
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/hetzner_default_rsa_key
    IdentityFile ~/.ssh/ovh_default_rsa_key

# Marfeel mrf.io servers
Host *.mrf
    HostName %h.io
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso-cert

# Marfeel root domain servers
Host *.marfeel
    HostName %h.com
    Port 22002
    User ialonso
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/ialonso-cert

# Other
# Host *
