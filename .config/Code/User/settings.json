{
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[django-html]": {},
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[dockerfile]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false
    },
    "[helm]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[jinja-html]": {
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": false,
        "editor.tabSize": 2
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.tabSize": 2
    },
    "[python]": {
        "editor.codeLens": false,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[xml]": {
        "editor.autoClosingBrackets": "never",
        "files.trimFinalNewlines": false,
        "files.trimTrailingWhitespace": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": false
    },
    "accessibility.signals.terminalBell": {
        "sound": "on"
    },
    "ansible.ansibleLint.arguments": "-x \"yaml[line-length]\"",
    "ansible.lightspeed.enabled": false,
    "black-formatter.args": [
        "--skip-string-normalization",
        "--line-length=88"
    ],
    "bracket-pair-colorizer-2.colorMode": "Independent",
    "bracket-pair-colorizer-2.showBracketsInGutter": true,
    "bracket-pair-colorizer-2.showBracketsInRuler": true,
    "chat.commandCenter.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "opus",
    "debug.allowBreakpointsEverywhere": true,
    "debug.console.fontSize": 13,
    "discord.detailsEditing": "Editing {file_name}:{current_line}",
    "discord.largeImage": "{lang}",
    "discord.largeImageIdling": "AFK",
    "discord.lowerDetailsDebugging": "Workspace: {workspace}:{git_branch}",
    "discord.lowerDetailsEditing": "Workspace: {workspace}:{git_branch}",
    "discord.lowerDetailsIdling": "{empty}",
    "discord.lowerDetailsNoWorkspaceFound": "{empty}",
    "django.i18n": false,
    "docker.showStartPage": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.accessibilitySupport": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.detectIndentation": true,
    "editor.dragAndDrop": false,
    "editor.emptySelectionClipboard": true,
    "editor.find.seedSearchStringFromSelection": "selection",
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": false,
    "editor.fontSize": 13,
    "editor.fontWeight": "normal",
    "editor.guides.bracketPairs": true,
    "editor.inlineSuggest.minShowDelay": 250,
    "editor.linkedEditing": true,
    "editor.minimap.showSlider": "always",
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.occurrencesHighlight": "singleFile",
    "editor.quickSuggestionsDelay": 50,
    "editor.rulers": [
        88,
        120
    ],
    "editor.selectionClipboard": false,
    "editor.showFoldingControls": "mouseover",
    "editor.smoothScrolling": true,
    "editor.snippetSuggestions": "top",
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "editor.suggest.showStatusBar": true,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "on",
    "editor.tabSize": 4,
    "editor.trimAutoWhitespace": true,
    "editor.useTabStops": true,
    "editor.wordSeparators": "./\\()\"'-:,.;<>~!@#$%^&*|+=[]{}`~?",
    "editor.wrappingIndent": "deepIndent",
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "errorLens.enabled": true,
    "errorLens.messageTemplate": "[1/$count] $message [$source] <$code> ($severity)",
    "explorer.autoReveal": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.sortOrder": "filesFirst",
    "extensions.autoUpdate": "off",
    "files.associations": {
        "**/*.html": "html",
        "**/galaxy.{yaml,yml}": "ansible",
        "**/handlers/*.{yaml,yml}": "ansible",
        "**/inventory/*.{yaml,yml}": "ansible",
        "**/meta/*.{yaml,yml}": "ansible",
        "**/molecule/*/*.{yaml,yml}": "ansible",
        "**/playbooks/*.{yaml,yml}": "ansible",
        "**/requirements{/**,*}.{txt,in}": "pip-requirements",
        "**/roles/*.{yaml,yml}": "ansible",
        "**/tasks/*.{yaml,yml}": "ansible",
        "**/templates/**/*.html": "jinja-html",
        "**/vault/*.{yaml,yml}": "ansible",
        "**/{host_vars,group_vars,vars,defaults}/**/*.{yaml,yml}": "ansible",
        "*.html": "html",
        "*.js.{jinja,jinja2,j2}": "jinja-js",
        "*.sh.{jinja,jinja2,j2}": "jinja-shell"
    },
    "files.autoSave": "off",
    "files.encoding": "utf8",
    "files.exclude": {
        "**/*.egg-info": true,
        "**/*.pyc": true,
        "**/*venv": true,
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.git": true,
        "**/.mypy_cache": true,
        "**/.project": true,
        "**/.pytest_cache": true,
        "**/.settings": true,
        "**/__pycache__": true
    },
    "files.hotExit": "onExit",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": true,
    "flake8.args": [
        "--max-line-length=88",
        "--ignore=E501"
    ],
    "git.autofetch": true,
    "githubPullRequests.terminalLinksHandler": "github",
    "gitlens.blame.highlight.locations": [
        "overview",
        "gutter",
        "line"
    ],
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.showWelcomeOnInstall": false,
    "gitlens.telemetry.enabled": false,
    "html-css-class-completion.enableEmmetSupport": true,
    "html.format.endWithNewline": true,
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.templating": true,
    "html.format.wrapAttributes": "aligned-multiple",
    "jupyter.interactiveWindow.textEditor.executeSelection": false,
    "markdownlint.config": {
        "MD007": false,
        "MD033": false,
        "MD041": false
    },
    "markdownlint.ignore": [
        ".github/*"
    ],
    "mypy-type-checker.args": [
        "--check-untyped-defs",
        "--disallow-any-generics",
        "--disallow-incomplete-defs",
        "--follow-imports=silent",
        "--ignore-missing-imports",
        "--no-implicit-optional",
        "--no-implicit-reexport",
        "--show-error-codes",
        "--warn-redundant-casts",
        "--warn-return-any",
        "--warn-unreachable",
        "--warn-unused-configs",
        "--warn-unused-ignores"
    ],
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
